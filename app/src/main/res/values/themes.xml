<resources>
    <!-- Base application theme. -->
    <style name="Theme.Quran" parent="Theme.Material3.DayNight">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@android:color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@android:color/black</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">@color/purple_700</item>
        <!-- Customize your theme here. -->
        <item name="android:windowBackground">@color/daluang</item>
        <item name="android:textColor">@android:color/black</item>
        <item name="android:itemBackground">@color/daluang</item>
        <item name="android:textColorPrimary">@android:color/black</item>
    </style>

    <style name="Theme.Quran.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="Theme.Quran.AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar" />

    <style name="Theme.Quran.PopupOverlay" parent="ThemeOverlay.AppCompat.Light" />

</resources>